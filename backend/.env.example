MONGODB_URI=
PORT=3000
NODE_ENV=development
JWT_SECRET=your_jwt_secret_here
CORS_ALLOWED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001,http://localhost:5173,http://127.0.0.1:5173
ADMIN_SUPER_CODE=your_strong_admin_super_code_here

REDIS_URL=redis://localhost:6379

# LLM Integration (Subject Identification Pipeline)
GEMINI_API_KEY=
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash

GEMINI_ASSISTANT_API_KEY=
ASSISTANT_MODE=llm

# Gmail OAuth Integration (Admin Inbox)
GOOGLE_GMAIL_CLIENT_ID=your_gmail_client_id_here
GOOGLE_GMAIL_CLIENT_SECRET=your_gmail_client_secret_here
GOOGLE_GMAIL_REDIRECT_URI=http://localhost:3000/api/admin/inbox/oauth/callback
GOOGLE_GMAIL_SCOPES=https://www.googleapis.com/auth/gmail.modify

# Telegram Integration (Customer Support Bridge)
SUPPORT_CHAT_ENABLED=true
TELEGRAM_SUPPORT_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_SUPPORT_CHAT_ID=-100xxxxxxxxxx
TELEGRAM_SUPPORT_ALLOWED_USER_IDS=123456789,987654321
TELEGRAM_SUPPORT_WEBHOOK_SECRET=your_telegram_webhook_secret_here

# Sentry Monitoring
SENTRY_DSN=your_sentry_dsn_here
SENTRY_TRACES_SAMPLE_RATE=1.0
SENTRY_PROFILES_SAMPLE_RATE=1.0

# Brevo Email Marketing (Mailing system)
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=noreply@low-analysis.dev
BREVO_SENDER_NAME="Low Analysis Admin"

# Frontend URL (for password reset links)
FRONTEND_URL=http://localhost:3001

# Telegram Webhook Auto Register (Auto-register Webhook on startup)
TELEGRAM_WEBHOOK_AUTO_REGISTER=false

# Public URL of the backend (used for webhooks and logs)
BACKEND_PUBLIC_URL=

# AI Assistant enablement flag
ASSISTANT_ENABLED=false

