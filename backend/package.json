  "description": "Low Analysis backend API and parser.",
  "main": "src/server.js",
  "type": "module",
  "imports": {
    "#*": "./src/*"
  },
  "scripts": {
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/**/*.js",
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "worker": "node src/worker.js",
    "worker:dev": "nodemon src/worker.js",
    "format": "prettier --write .",
    "check-format": "prettier --check .",
    "ci": "npm run lint && npm run test:run"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@getbrevo/brevo": "^5.0.4",
