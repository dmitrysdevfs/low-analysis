{
  "name": "low-analysis-monorepo",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -n backend,frontend -c yellow,cyan \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "install:all": "npm install",
    "lint": "npm run lint --workspaces",
    "typecheck": "npm run typecheck --workspace=frontend",
    "test": "npm run test:run --workspaces",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "format": "npm run format --workspaces",
    "check-format": "npm run check-format --workspaces",
    "audit:all": "npm audit --audit-level=high --workspaces",
    "prepare": "husky || true"
  },
  "lint-staged": {
    "**/*.{js,ts,tsx,scss,css,json,md}": "prettier --write"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.3"
  }
}
